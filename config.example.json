{
  "relay": {
    "port": 3334
  },
  "admin": {
    "port": 3335
  },
  "database": {
    "type": "sqlite",
    "dsn": "./congee.db"
  },
  "logging": {
    "level": "info",
    "format": "json"
  },
  "audit": {
    "retention_days": 30
  },
  "metrics": {
    "relay_bucket_retention_days": 30
  },
  "rate_limits": {
    "events_per_minute_per_connection": 120,
    "bytes_per_second_per_connection": 1048576,
    "reqs_per_minute_per_connection": 60,
    "messages_per_minute_per_ip": 6000
  },
  "connection_limits": {
    "max_open": 10000,
    "max_subscriptions_per_connection": 20,
    "max_filters_per_req": 10,
    "connections_per_minute_per_ip": 60,
    "read_deadline_seconds": 120,
    "write_deadline_seconds": 30,
    "default_query_limit": 500
  },
  "websocket": {
    "compression_enabled": true,
    "max_message_bytes": 1048576
  },
  "max_subscription_id_length": 128,
  "nip11": {
    "name": "Congee",
    "description": "Nostr relay (example metadata)",
    "pubkey": "",
    "contact": "",
    "software": "https://github.com/michmich112/congee",
    "cors_allow_any_origin": false
  },
  "nip42": {
    "relay_url": "",
    "send_challenge_on_connect": false,
    "created_at_skew_seconds": 600,
    "require_auth_subscribe_kinds": [],
    "require_auth_publish_kinds": [],
    "allowlisted_pubkeys": []
  },
  "nip29": {
    "late_publication_max_past_seconds": 86400,
    "strict_previous_same_h": false
  },
  "nip17": {
    "reject_gift_wrap_when_disabled": true
  },
  "nips": {
    "enabled": [1, 11]
  }
}
