# Copy to `.env` in the repo root (gitignored). Loaded automatically on startup from the
# process working directory — run `make dev` or `./bin/congee` from the project root.
#
# Values here are merged into the environment before CONFIG_PATH is read. Existing
# shell exports take precedence (godotenv does not override set variables by default).

# CONGEE_ENV=development
# ENABLE_ADMIN_UI=true
# ADMIN_PASSWORD=change-me
# Default binary config path is /data/config/config.json. For local repo development use:
# CONFIG_PATH=./config.json
# Path to relay signing secrets JSON (secp256k1). Default: relay.secrets.json next to the config file directory.
# RELAY_SECRETS_PATH=
# CONGEE_RELAY_PORT=
# CONGEE_ADMIN_PORT=
# CONGEE_DATA_DIR=
# CONGEE_INSTANCE_ID=   # optional; overrides relay.instance_id for PostgreSQL NOTIFY origin (locks UI edits)
