{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow"
  },
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 10000
  },
  "instructions": [
    "AGENTS.md",
    "AGENT.md"
  ],
  "provider": {
    "llmate": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LLMate",
      "options": {
        "apiKey": "{env:LLMATE_API_KEY}",
        "baseURL": "{env:LLMATE_BASE_URL}",
        "timeout": 600000000,
        "chunkTimeout": 30000000
      },
      "models": {
        "Github": {
          "name": "Github",
          "limit": {
            "context": 262144,
            "input": 200000,
            "output": 62144
          }
        }
      }
    }
  }
}